@page
@model HistoryModel
@{
    ViewData["Title"] = "History";
}

<h1 class="page-title">History</h1>
<div class="row g-3 mt-0">
    <div class="col-6">
        <div class="card">
            <div class="card-body">
                <div class="stat-label">Current Streak</div>
                <div class="stat-value">@Model.Streak @(Model.Streak == 1 ? "Day" : "Days")</div>
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="card">
            <div class="card-body">
                <div class="stat-label">Best Streak</div>
                <div class="stat-value">@Model.BestStreak @(Model.BestStreak == 1 ? "Day" : "Days")</div>
            </div>
        </div>
    </div>
</div>
<h2 class="section-title">Days</h2>
@if (Model.Days.Count == 0)
{
    <p class="text-muted">Nothing recorded yet.</p>
}
else
{
    <div class="list-group">
        <div class="list-group-item history-row item-sub">
            <span>Date</span>
            <span>Stretching</span>
            <span>Workout</span>
            <span>Other</span>
        </div>
        @foreach (HistoryDay day in Model.Days)
        {
            bool today = day.Date == Model.Today;
            <div class="list-group-item history-row">
                <div class="text-nowrap">
                    <div class="item-name">@day.Date.ToString("ddd d MMM")</div>
                    <div class="item-sub">@(day.Kilograms.HasValue ? $"{day.Kilograms:0.0} kg" : "No Weigh In")</div>
                </div>
                <div><span class="badge @(day.Stretching ? "soft-success" : today ? "soft" : "soft-danger")">@(day.Stretching ? "Done" : today ? "Pending" : "Missed")</span></div>
                <div>
                    @if (day.WorkoutName.Length > 0)
                    {
                        <span class="badge @(day.WorkoutDone ? "soft-success" : day.OtherDone || today ? "soft" : "soft-danger")">@day.WorkoutName</span>
                    }
                    else
                    {
                        <span class="item-sub">-</span>
                    }
                </div>
                <div>
                    @if (day.OtherDone)
                    {
                        <span class="badge soft-success" title="@day.Other">@day.Other</span>
                    }
                    else
                    {
                        <span class="item-sub">-</span>
                    }
                </div>
            </div>
        }
    </div>
}