@page
@model ScheduleModel
@{
    ViewData["Title"] = "Schedule";
}

<h1 class="page-title">Schedule</h1>
<div class="page-sub">Week @Model.CurrentWeek of @Model.Weeks.Count</div>
<h2 class="section-title">@Model.Stretching.Name <span class="sub">· @Model.Stretching.Moves.Count Moves, Every Day</span></h2>
<div class="list-group">
    <partial name="_MoveList" model="Model.Stretching" />
</div>
@foreach (ScheduleWeek week in Model.Weeks)
{
    <h2 class="section-title d-flex align-items-center gap-2">
        Week @week.Number
        @if (week.Number == Model.CurrentWeek)
        {
            <span class="badge soft-primary">Current</span>
        }
    </h2>
    <div class="list-group">
        @foreach (ScheduleEntry entry in week.Days)
        {
            <div class="list-group-item day-row d-flex justify-content-between align-items-baseline gap-3">
                <span class="item-name">@entry.Day · @(entry.Workout?.Name ?? "Rest Day")</span>
                <span class="item-sub text-end">@entry.Workout?.Summary</span>
            </div>
            @if (entry.Workout != null)
            {
                <partial name="_MoveList" model="entry.Workout" />
            }
        }
    </div>
}