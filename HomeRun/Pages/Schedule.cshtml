@page
@model ScheduleModel
@{
    ViewData["Title"] = "Schedule";
}

<h1>Schedule</h1>
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <strong>@Model.Stretching.Name</strong>
        <span class="text-muted">@Model.Stretching.Summary</span>
    </div>
    <table class="table table-sm mb-0" style="table-layout: fixed">
        <thead>
            <tr>
                <th class="w-50">Move</th>
                <th class="w-50">Reps / Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Move move in Model.Stretching.Moves)
            {
                <tr>
                    <td title="@move.Description">@move.Name</td>
                    <td>@move.Amount</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="row row-cols-1 row-cols-lg-2 g-3">
    @foreach (ScheduleWeek week in Model.Weeks)
    {
        <div class="col">
            <div class="card h-100 @(week.Number == Model.CurrentWeek ? "border-primary" : "")">
                <div class="card-header d-flex justify-content-between">
                    <strong>Week @week.Number</strong>
                    @if (week.Number == Model.CurrentWeek)
                    {
                        <span class="badge bg-primary">Current</span>
                    }
                </div>
                <table class="table table-sm mb-0" style="table-layout: fixed">
                    <thead>
                        <tr>
                            <th class="w-50">Move</th>
                            <th class="w-50">Reps / Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ScheduleEntry entry in week.Days)
                        {
                            <tr class="table-secondary">
                                <th colspan="2">@entry.Day - @(entry.Workout?.Name ?? "Rest Day")<span class="float-end fw-normal">@entry.Workout?.Summary</span></th>
                            </tr>
                            @if (entry.Workout != null)
                            {
                                @foreach (Move move in entry.Workout.Moves)
                                {
                                    <tr>
                                        <td title="@move.Description">@move.Name</td>
                                        <td>@(move.Type == MoveType.Interval ? entry.Workout.WorkSeconds + "s" : move.Amount)</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>