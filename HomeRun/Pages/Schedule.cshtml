@page
@model ScheduleModel
@{
    ViewData["Title"] = "Schedule";
}

<h1>Schedule</h1>
<p class="text-muted">Every workout starts with a @Model.WarmUp.Minutes minute warm-up: @string.Join(", ", Model.WarmUp.Moves).</p>
@foreach (ScheduleWeek week in Model.Weeks)
{
    <div class="card mb-3 @(week.Number == Model.CurrentWeek ? "border-primary" : "")">
        <div class="card-header d-flex justify-content-between">
            <strong>Week @week.Number</strong>
            @if (week.Number == Model.CurrentWeek)
            {
                <span class="badge bg-primary">Current</span>
            }
        </div>
        <ul class="list-group list-group-flush">
            @foreach (ScheduleEntry entry in week.Days)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between">
                        <strong>@entry.Day</strong>
                        <span>@(entry.Workout?.Name ?? "Rest Day")</span>
                    </div>
                    @if (entry.Workout != null)
                    {
                        <div class="small">@entry.Workout.Summary</div>
                        @foreach (Move move in entry.Workout.Moves)
                        {
                            <div class="small text-muted">@move.Name@(move.Summary.Length > 0 ? " - " + move.Summary : "")@(move.Notes != null ? " (" + move.Notes + ")" : "")</div>
                        }
                    }
                </li>
            }
        </ul>
    </div>
}