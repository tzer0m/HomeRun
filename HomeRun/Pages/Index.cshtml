@page
@model IndexModel
@{
    ViewData["Title"] = "Today";
}

<div class="d-flex justify-content-between align-items-baseline">
    <h1 class="h3">@Model.Today.ToString("dddd d MMMM")</h1>
    <span class="text-muted">
        @if (Model.Streak > 0)
        {
            <span class="badge bg-success me-2">@Model.Streak @(Model.Streak == 1 ? "Day" : "Days") Streak</span>
        }
        Week @Model.Week
    </span>
</div>
<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <div class="text-muted">@(Model.Eating ? "Eating Window Closes In" : "Eating Window Opens In")</div>
            <div class="fs-3" id="countdown" data-target="@Model.FastingTarget.ToUnixTimeMilliseconds()">@Model.RemainingText</div>
        </div>
        <span class="badge @(Model.Eating ? "bg-success" : "bg-secondary")">@(Model.Eating ? "Eating" : "Fasting")</span>
    </div>
</div>
<ul class="list-group checklist">
    <li class="list-group-item @(Model.WeightRecorded ? "list-group-item-success" : "") d-flex justify-content-between align-items-center">
        <span>Weigh In</span>
        <div class="d-flex align-items-center gap-3">
            <span class="weight-view @(Model.WeightRecorded ? "" : "d-none")">@Model.Weight?.ToString("0.0") kg</span>
            <form class="weight-form d-flex gap-2 @(Model.WeightRecorded ? "d-none" : "")" method="post">
                <input class="form-control" style="width: 6rem" type="number" name="weight" step="0.1" min="0" value="@Model.Weight?.ToString("0.0")" placeholder="kg" aria-label="Weight (kg)" />
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
            <input class="form-check-input" type="checkbox" checked="@Model.WeightRecorded" disabled="@(!Model.WeightRecorded)" onchange="toggleWeight(this)" aria-label="Weigh In Done" />
        </div>
    </li>
    @foreach (ChecklistItem item in Model.Items)
    {
        <li class="list-group-item @(item.Done ? "list-group-item-success" : "") d-flex justify-content-between align-items-center">
            <span>@item.Name</span>
            <div class="d-flex align-items-center gap-3">
                @if (item.HasSession && !item.Done)
                {
                    <a class="btn btn-primary" href="/session/@item.Id">Start</a>
                }
                <form method="post" asp-page-handler="Tick">
                    <input type="hidden" name="item" value="@item.Id" />
                    <input class="form-check-input" type="checkbox" checked="@item.Done" onchange="this.form.submit()" aria-label="@item.Name Done" />
                </form>
            </div>
        </li>
    }
</ul>