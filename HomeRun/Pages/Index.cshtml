@page
@model IndexModel
@{
    ViewData["Title"] = "Today";
}

<div class="d-flex justify-content-between align-items-center gap-2">
    <div>
        <h1 class="page-title">@Model.Today.ToString("dddd d MMMM")</h1>
        <div class="page-sub">Week @Model.Week</div>
    </div>
    @if (Model.Streak > 0)
    {
        <span class="badge soft-success">@Model.Streak @(Model.Streak == 1 ? "Day" : "Days") Streak</span>
    }
</div>
<div class="card mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            @if (Model.FastingEnabled)
            {
                <div>
                    <div class="stat-label">@(Model.Eating ? "Eating Window Closes In" : "Eating Window Opens In")</div>
                    <div class="stat-value" id="countdown" data-target="@Model.FastingTarget.ToUnixTimeMilliseconds()">@Model.RemainingText</div>
                </div>
            }
            else
            {
                <div>
                    <div class="item-name">Fasting</div>
                    <div class="item-sub">Off</div>
                </div>
            }
            <div class="d-flex align-items-center gap-3">
                @if (Model.FastingEnabled)
                {
                    <span class="badge @(Model.Eating ? "soft-success" : "soft")">@(Model.Eating ? "Eating" : "Fasting")</span>
                }
                <form class="form-check form-switch m-0" method="post" asp-page-handler="Fasting">
                    <input type="hidden" name="enabled" value="@(Model.FastingEnabled ? "false" : "true")" />
                    <input class="form-check-input" type="checkbox" role="switch" checked="@Model.FastingEnabled" onchange="this.form.submit()" aria-label="Fasting" />
                </form>
            </div>
        </div>
        @if (Model.FastingPrompt.Length > 0)
        {
            <div class="text-warning small mt-2">@Model.FastingPrompt</div>
        }
    </div>
</div>
<h2 class="section-title">Checklist</h2>
<ul class="list-group checklist">
    <li class="list-group-item @(Model.WeightRecorded ? "list-group-item-success" : "") d-flex justify-content-between align-items-center">
        <div class="item-name">Weigh In</div>
        <div class="d-flex align-items-center gap-3">
            <span class="entry-view @(Model.WeightRecorded ? "" : "d-none")">@Model.Weight?.ToString("0.0") kg</span>
            <form class="entry-form d-flex gap-2 @(Model.WeightRecorded ? "d-none" : "")" method="post">
                <input class="form-control" style="width: 6rem" type="number" name="weight" step="0.1" min="0" value="@Model.Weight?.ToString("0.0")" placeholder="kg" aria-label="Weight (kg)" />
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
            <input class="form-check-input" type="checkbox" checked="@Model.WeightRecorded" disabled="@(!Model.WeightRecorded)" onchange="toggleEntry(this)" aria-label="Weigh In Done" />
        </div>
    </li>
    @foreach (ChecklistItem item in Model.Items)
    {
        <li class="list-group-item @(item.Done ? "list-group-item-success" : "") d-flex justify-content-between align-items-center">
            <div>
                <div class="item-name">@item.Name</div>
                @if (item.Detail.Length > 0)
                {
                    <div class="item-sub">@item.Detail</div>
                }
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (item.HasSession && !item.Done)
                {
                    <a class="btn btn-primary" href="/session/@item.Id">Start</a>
                }
                <form method="post" asp-page-handler="Tick">
                    <input type="hidden" name="item" value="@item.Id" />
                    <input class="form-check-input" type="checkbox" checked="@item.Done" onchange="this.form.submit()" aria-label="@item.Name Done" />
                </form>
            </div>
        </li>
    }
    <li class="list-group-item @(Model.OtherDone ? "list-group-item-success" : "") d-flex justify-content-between align-items-center gap-3">
        <div class="text-nowrap">
            <div class="item-name">@Model.OtherName</div>
            <div class="item-sub">Optional</div>
        </div>
        <div class="d-flex align-items-center gap-3 flex-grow-1 justify-content-end" style="min-width: 0">
            <span class="entry-view text-end @(Model.OtherDone ? "" : "d-none")">@Model.OtherNote</span>
            <form class="entry-form d-flex gap-2 flex-grow-1 justify-content-end @(Model.OtherDone ? "d-none" : "")" style="min-width: 0" method="post" asp-page-handler="Other">
                <input class="form-control" style="min-width: 0; max-width: 12rem" type="text" name="note" maxlength="100" value="@Model.OtherNote" placeholder="e.g. Padel" aria-label="Other Exercise" />
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
            <input class="form-check-input" type="checkbox" checked="@Model.OtherDone" disabled="@(!Model.OtherDone)" onchange="toggleEntry(this)" aria-label="@Model.OtherName Done" />
        </div>
    </li>
</ul>