@page
@model IndexModel
@{
    ViewData["Title"] = "Today";
}

<div class="d-flex justify-content-between align-items-baseline">
    <h1 class="h3">@Model.Today.ToString("dddd d MMMM")</h1>
    <span class="text-muted">Week @Model.Week</span>
</div>
<div class="card mb-3">
    <div class="card-body d-flex justify-content-between align-items-center">
        <div>
            <div class="text-muted">@(Model.Eating ? "Eating Window Closes In" : "Eating Window Opens In")</div>
            <div class="fs-3" id="countdown" data-target="@Model.FastingTarget.ToString("o")">@Model.RemainingText</div>
        </div>
        <span class="badge @(Model.Eating ? "bg-success" : "bg-secondary")">@(Model.Eating ? "Eating" : "Fasting")</span>
    </div>
</div>
<ul class="list-group checklist">
    @if (Model.WeightRecorded)
    {
        <li class="list-group-item list-group-item-success d-flex justify-content-between align-items-center">
            <span>Weigh In</span>
            <span>@Model.Weight?.ToString("0.0") kg</span>
        </li>
    }
    else
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>Weigh In</span>
            <form class="d-flex gap-2" method="post">
                <input class="form-control" style="width: 6rem" type="number" name="weight" step="0.1" min="0" placeholder="kg" aria-label="Weight (kg)" />
                <button class="btn btn-primary" type="submit">Save</button>
            </form>
        </li>
    }
    <li class="list-group-item d-flex justify-content-between align-items-center">
        <span>@Model.Stretching.Name</span>
        <a class="btn btn-primary" href="/session/@Model.Stretching.Id">Start</a>
    </li>
    @if (Model.Workout != null)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            @if (Model.Workout.Type == WorkoutType.Tick)
            {
                <label class="flex-grow-1" for="workout-done">@Model.Workout.Name</label>
                <input class="form-check-input" type="checkbox" id="workout-done" />
            }
            else
            {
                <span>@Model.Workout.Name</span>
                <a class="btn btn-primary" href="/session/@Model.Workout.Id">Start</a>
            }
        </li>
    }
</ul>