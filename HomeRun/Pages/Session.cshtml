@page "/session/{id}"
@model SessionModel
@{
    ViewData["Title"] = Model.Workout.Name;
}

<div id="start" class="card text-center">
    <div class="card-body py-4">
        <h1 class="page-title">@Model.Workout.Name</h1>
        <div class="page-sub mb-3">@(Model.Workout.Summary.Length > 0 ? Model.Workout.Summary : $"{Model.Workout.Moves.Count} Moves")</div>
        <button id="start-button" class="btn btn-primary btn-lg px-5" type="button">Start</button>
    </div>
</div>
<div id="run" class="runner text-center d-none">
    <div class="progress">
        <div id="progress" class="progress-bar" style="width: 0%"></div>
    </div>
    <div class="runner-round"><span id="round" class="badge soft"></span></div>
    <h1 id="title" class="fs-3 fw-semibold"></h1>
    <div class="runner-main">
        <div class="ring-wrap">
            <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle class="ring-track" cx="60" cy="60" r="54"></circle>
                <circle id="ring" class="ring" cx="60" cy="60" r="54" transform="rotate(-90 60 60)"></circle>
            </svg>
            <div id="step-countdown"></div>
        </div>
        <div id="move-stage" class="move-stage">
            <div id="move-figure" class="move-figure"></div>
            <div class="move-next">Next</div>
        </div>
    </div>
    <p id="description" class="text-muted"></p>
    <div class="d-flex gap-2">
        <button id="action-button" class="btn btn-primary btn-lg flex-fill" type="button">Pause</button>
        <button id="skip-button" class="btn btn-outline-secondary btn-lg flex-fill" type="button">Skip</button>
    </div>
    <div class="upcoming text-start">
        <div class="small text-uppercase text-muted">Routine</div>
        <ul id="upcoming" class="list-unstyled m-0"></ul>
    </div>
</div>
<div id="complete" class="card text-center d-none">
    <div class="card-body py-4">
        <h1 class="page-title">Complete</h1>
        <div id="saved" class="page-sub mb-3"></div>
        <a class="btn btn-primary btn-lg" href="/">Back to Today</a>
    </div>
</div>
<form id="complete-form" method="post" asp-page-handler="complete" asp-route-id="@Model.Workout.Id"></form>
<script id="steps" type="application/json">@Html.Raw(Model.StepsJson)</script>
@section Scripts {
    <script src="~/js/moves.js" asp-append-version="true"></script>
    <script src="~/js/session.js" asp-append-version="true"></script>
}