@page "/session/{id}"
@model SessionModel
@{
    ViewData["Title"] = Model.Workout.Name;
}

<div id="start" class="text-center">
    <h1>@Model.Workout.Name</h1>
    <p class="text-muted">@Model.Workout.Summary</p>
    <button id="start-button" class="btn btn-primary btn-lg" type="button">Start</button>
</div>
<div id="run" class="runner text-center d-none">
    <div class="progress">
        <div id="progress" class="progress-bar" style="width: 0%"></div>
    </div>
    <div id="round" class="text-muted"></div>
    <h1 id="title" class="fs-3"></h1>
    <p id="detail" class="fs-4"></p>
    <p id="description" class="text-muted"></p>
    <div id="step-countdown" class="display-4"></div>
    <div class="d-flex justify-content-center gap-3">
        <button id="action-button" class="btn btn-secondary btn-lg" type="button">Pause</button>
        <button id="skip-button" class="btn btn-outline-secondary btn-lg" type="button">Skip</button>
    </div>
    <p id="next" class="text-muted"></p>
</div>
<div id="complete" class="text-center d-none">
    <h1>Complete</h1>
    <a class="btn btn-primary btn-lg" href="/">Back to Today</a>
</div>
<script id="steps" type="application/json">@Html.Raw(Model.StepsJson)</script>
@section Scripts {
    <script src="~/js/session.js" asp-append-version="true"></script>
}