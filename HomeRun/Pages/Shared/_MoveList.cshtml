@model Workout
@foreach (Move move in Model.Moves)
{
    <div class="list-group-item d-flex justify-content-between align-items-center gap-3" title="@move.Description">
        <span>@move.Name</span>
        <span class="item-sub text-end">@(move.Type == MoveType.Interval ? Model.WorkSeconds + "s" : move.Amount)</span>
    </div>
}